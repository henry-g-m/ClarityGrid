# Copy to .env and fill in the Postgres admin password (kept out of git).
DATABASE_URL=postgresql://cgadmin:<password>@claritygrid-pg-dev.postgres.database.azure.com:5432/claritygrid?sslmode=require

# Observability (optional). Leave unset for local dev: logs still go to the
# console, but traces/metrics have nowhere to export to. Set to the
# Application Insights connection string to ship logs, traces, and metrics
# there (see infra/main.bicep output APPLICATIONINSIGHTS_CONNECTION_STRING).
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO
